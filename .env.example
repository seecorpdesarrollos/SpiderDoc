# ---------------------------------------------------------------------------
# Spiderjad Docs — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Panel de Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Sirve tanto la anon key clásica (eyJ...) como la nueva publishable (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Gemini (OCR) ---------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-3.6-flash
# Google retira modelos cada cierto tiempo; si la API devuelve un 404
# diciendo que el modelo ya no existe, el propio error te dice cuál usar.
GEMINI_MODEL=gemini-3.6-flash

# --- App -------------------------------------------------------------------
# URL pública de la app; se usa para el redirect del magic link.
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
