# ---------------------------------------------------------------------------
# Spiderjad Docs — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Panel de Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Panel de Supabase > Project Settings > API Keys > service_role
# SECRETA. Nunca la expongas en el cliente ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (OCR) ---------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- App -------------------------------------------------------------------
# URL pública de la app; se usa para el redirect del magic link.
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
