# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo la usa el cron de avisos (/api/cron/avisos), nada más.
#
# ⚠️ Esta clave se salta RLS: abre TODOS los documentos y TODAS las imágenes
# escaneadas de todos los usuarios. Nunca en el navegador, nunca en el
# repositorio, nunca pegada en un chat. Si se filtra, se rota desde el panel
# de Supabase.
#
# El cron no consulta las tablas directamente: llama a pending_notifications(),
# que devuelve solo email, título y fecha. Eso no protege de que roben la
# clave, pero sí de que un error nuestro filtre una foto de un pasaporte.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (OCR) ──────────────────────────────────────────────────────────
# aistudio.google.com/apikey
GEMINI_API_KEY=

# Google retira modelos cada pocos meses (en agosto de 2026 se cayó
# gemini-2.5-flash). Por eso el modelo va en el entorno: cuando vuelva a pasar
# se cambia aquí, sin tocar código.
GEMINI_MODEL=gemini-3.6-flash

# ── Resend (avisos de caducidad) ──────────────────────────────────────────
# resend.com → API Keys. Permiso "Sending access".
RESEND_API_KEY=

# Remitente de los avisos. El dominio tiene que estar verificado en Resend.
# No hace falta que exista como buzón.
RESEND_FROM=Spiderjad Docs <avisos@bytweb.com>

# ── Notificaciones push (VAPID) ────────────────────────────────────────────
# Generá el par con:   npx web-push generate-vapid-keys
#
# La pública va al navegador (por eso lleva NEXT_PUBLIC_); la privada NUNCA.
# Sin estas dos claves los avisos push simplemente no se activan — el correo
# sigue funcionando igual.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Un contacto para los servicios de push, por si tienen que avisar de algo.
VAPID_SUBJECT=mailto:avisos@bytweb.com

# ── Cron ──────────────────────────────────────────────────────────────────
# Cualquier cadena larga y aleatoria. Vercel la manda en la cabecera
# Authorization al ejecutar el cron; sin ella, /api/cron/avisos devuelve 404.
# Generala con: openssl rand -base64 32
CRON_SECRET=

# ── Solo desarrollo ───────────────────────────────────────────────────────
# IP de tu equipo en la red local, para abrir la app desde el móvil.
# Next bloquea recursos de dev desde otro origen si no está declarada.
# En producción no se pone.
DEV_ORIGIN=

# Banco de pruebas del OCR en /probar.
# ⚠️ Con valor 1 expone un endpoint SIN AUTENTICAR que llama a Gemini.
# Dejar en 0 salvo mientras se prueba. NUNCA ponerlo a 1 en producción.
PROBAR_OCR=0
